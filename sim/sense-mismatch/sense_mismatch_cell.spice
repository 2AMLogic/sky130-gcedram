vrwld rwl_des 0 dc {VDD}
vpre  prea 0 dc {VRBL}
vref_050 pref_050 0 dc 0.85   $ reference = VRBL - 0.05 (ASSUMPTION)
vref_100 pref_100 0 dc 0.8   $ reference = VRBL - 0.1 (ASSUMPTION)

