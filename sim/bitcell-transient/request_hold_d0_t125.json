{
  "netlist": "bitcell_d0.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ss",
      "ff",
      "sf",
      "fs"
    ],
    "temperature_c": [
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "10p 4.667328e-03 0 2.333637e-06"
  },
  "measurements": [
    {
      "name": "v_sn_end_wl_pulse_v",
      "unit": "V",
      "spice": ".meas tran v_sn_end_wl_pulse_v FIND v(sn) AT=2.100000e-08"
    },
    {
      "name": "v_sn_after_write_settled_v",
      "unit": "V",
      "spice": ".meas tran v_sn_after_write_settled_v FIND v(sn) AT=2.950000e-08"
    },
    {
      "name": "v_sn_read_gate_v",
      "unit": "V",
      "spice": ".meas tran v_sn_read_gate_v FIND v(sn) AT=4.950000e-08"
    },
    {
      "name": "v_sn_hold_start_v",
      "unit": "V",
      "spice": ".meas tran v_sn_hold_start_v FIND v(sn) AT=5.500000e-08"
    },
    {
      "name": "v_sn_slope_end_v",
      "unit": "V",
      "spice": ".meas tran v_sn_slope_end_v FIND v(sn) AT=9.340046e-05"
    },
    {
      "name": "v_sn_hold_end_v",
      "unit": "V",
      "spice": ".meas tran v_sn_hold_end_v FIND v(sn) AT=4.667327e-03"
    }
  ],
  "options": {
    "timeout_s": 3600,
    "keep_artifacts": false,
    "waveforms": false,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
