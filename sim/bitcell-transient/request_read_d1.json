{
  "netlist": "bitcell_d1.spice",
  "engine": "ngspice",
  "backend": "batch",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/combined/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ss",
      "ff",
      "sf",
      "fs"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "10p 5.500000e-08 0 1.000000e-11"
  },
  "measurements": [
    {
      "name": "i_rbl_deselect_raw_a",
      "unit": "A",
      "spice": ".meas tran i_rbl_deselect_raw_a FIND i(vrbl) AT=2.950000e-08"
    },
    {
      "name": "i_read_raw_a",
      "unit": "A",
      "spice": ".meas tran i_read_raw_a FIND i(vrbl) AT=4.950000e-08"
    }
  ],
  "options": {
    "timeout_s": 1800,
    "keep_artifacts": false,
    "waveforms": false,
    "ngspice_init": [
      "set measureprec=12",
      "set numdgt=12"
    ]
  }
}
