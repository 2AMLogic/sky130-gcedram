# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_gc_ctrl_top.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_liberty -lib $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_100C_1v60.lib
read_verilog digital/control-integration/synth/run/gc_ctrl_top_sv2v.v
hierarchy -check -top gc_ctrl_top
synth -top gc_ctrl_top
dfflibmap -liberty $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_100C_1v60.lib
tee -q -o digital/control-integration/synth/run/gc_ctrl_top_abc.log abc -liberty $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_100C_1v60.lib -constr digital/control-integration/synth/run/gc_ctrl_top_abc.constr -dont_use sky130_fd_sc_hd__lpflow_* -dont_use sky130_fd_sc_hd__probe*
clean
setundef -zero
hilomap -hicell sky130_fd_sc_hd__conb_1 HI -locell sky130_fd_sc_hd__conb_1 LO
tee -q -o digital/control-integration/synth/run/gc_ctrl_top_stats.json stat -liberty $PDK_ROOT/ciel/sky130/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ss_100C_1v60.lib -json -top gc_ctrl_top
write_verilog -noattr digital/control-integration/synth/run/gc_ctrl_top_synth.v
