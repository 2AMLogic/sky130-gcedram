  "commands": [
    "# Provision a klt 0.9.1 generation toolchain without touching the committed",
    "# 0.8.0 pin or any host-wide tool (worktree-local venv, gitignored):",
    "uv venv ${TOOLCHAINS}/klt-generation-v0.9.1-klayout-0.30.12",
    "uv pip install --python ${TOOLCHAINS}/klt-generation-v0.9.1-klayout-0.30.12/bin/python 'klayout-tools==0.9.1' 'klayout==0.30.12'",
    "KLT_GEN_091=${TOOLCHAINS}/klt-generation-v0.9.1-klayout-0.30.12/bin/klt",
    "# Regenerate the default 4x4 in a scratch dir with the SAME generation command",
    "# sequence layout/generate_array.sh runs (steps 1/7 and 2/7), the same",
    "# array_topology.py params, the same PDK pin:",
    "(cd ${SCRATCH} && cp ${REPO}/layout/array_topology.py . && ${KLT_GEN_091} gen mos_array --params \"$(python3 array_topology.py --rows 4 --cols 4 --emit gen-params)\" --pdk sky130A --pdk-root ${PDK_ROOT} --cell-name gain_cell_2t_array_mos -o gain_cell_2t_array_mos.gds --format json > gain_cell_2t_array_mos.json)",
    "(cd ${SCRATCH} && python3 array_topology.py --rows 4 --cols 4 --emit compose-request --mos-report gain_cell_2t_array_mos.json > gain_cell_2t_array.layout.request.json)",
    "(cd ${SCRATCH} && ${KLT_GEN_091} gen-compose gain_cell_2t_array.layout.request.json --format json > gain_cell_2t_array.layout.json)",
    "# Byte-level comparison (the gate that must keep reporting mismatch):",
    "(cd ${REPO} && python3 -I layout/compare_array_layout.py --committed layout --regenerated ${SCRATCH} --generation-only)",
    "# The geometry measurement this record holds:",
    "(cd ${REPO} && ${TOOLCHAINS}/klt-generation-v0.9.1-klayout-0.30.12/bin/python -I layout/xor_layout_geometry.py --committed layout/gain_cell_2t_array.gds --regenerated ${SCRATCH}/gain_cell_2t_array.gds --top gain_cell_2t_array_4x4_layout_0 --committed-toolchain-python ${TOOLCHAINS}/klt-generation-v0.8.0-klayout-0.30.12/bin/python --regenerated-toolchain-python ${TOOLCHAINS}/klt-generation-v0.9.1-klayout-0.30.12/bin/python -o layout/results/geometry_xor_klt0.9.1_vs_committed_20261114.json)"
