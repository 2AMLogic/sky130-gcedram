M_WR_1_3 sn_1_3 wl_1 bl_3 GND nfet L=0.15U W=0.42U
M_RD_1_3 rbl_3 sn_1_3 rwl_1 GND nfet L=0.15U W=0.42U
M_WR_2_0 sn_2_0 wl_2 bl_0 GND nfet L=0.15U W=0.42U
M_RD_2_0 rbl_0 sn_2_0 rwl_2 GND nfet L=0.15U W=0.42U
M_WR_2_1 sn_2_1 wl_2 bl_1 GND nfet L=0.15U W=0.42U
